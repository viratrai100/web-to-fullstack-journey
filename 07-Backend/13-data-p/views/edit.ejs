<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Virat Rai</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="w-full flex justify-end">
            <a class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block " href="/logout">Logout</a>
        </div>
        <h3 class="mb-5">edit your post</h3>
        <form  method="post" action="/update/<%= post._id %>">
            <textarea placeholder="What's on your mind" class=" block p-3 outline-no w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded.md" name="content" ><%= post.content %> </textarea>
            <input class="px-3 py-2 text-sm w-40 bg-yellow-500 text-black block rounded-md mt-2" type="submit" value="Update Post">
        </form>
    </div>
</body>
</html>

<%# user.posts.forEach(function(post) { %>